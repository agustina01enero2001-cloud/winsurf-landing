generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Tenant {
  id                String              @id @default(cuid())
  slug              String              @unique
  name              String
  active            Boolean             @default(true)
  adminPasswordHash String
  heroVideoPath     String?
  template          String              @default("winsurf") // winsurf | bienvenida
  directViews       Int                 @default(0)
  directClicks      Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  destinations      TenantDestination[]
  origins           TenantOrigin[]
  uniqueEvents      AnalyticsUnique[]
}

model TenantDestination {
  id        String   @id @default(cuid())
  tenantId  String
  type      String // whatsapp | url
  number    String?
  url       String?
  label     String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active, sortOrder])
}

model TenantOrigin {
  id         String            @id @default(cuid())
  tenantId   String
  key        String
  name       String
  active     Boolean           @default(true)
  views      Int               @default(0)
  clicks     Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  subOrigins TenantSubOrigin[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, active])
}

model TenantSubOrigin {
  id        String   @id @default(cuid())
  originId  String
  key       String
  name      String
  active    Boolean  @default(true)
  views     Int      @default(0)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  origin TenantOrigin @relation(fields: [originId], references: [id], onDelete: Cascade)

  @@unique([originId, key])
  @@index([originId, active])
}

/** One row per fingerprint + event kind + origin + suborigin (dedupe). */
model AnalyticsUnique {
  id           String   @id @default(cuid())
  tenantId     String
  kind         String // view | click
  originKey    String   @default("") // "" = direct / unknown origin
  subOriginKey String   @default("") // "" = origin-only / no suborigin
  visitorKey   String // hash of browser fingerprint, or IP fallback
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, originKey, subOriginKey, visitorKey])
  @@index([tenantId, kind])
}
